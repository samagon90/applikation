<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background">

    <!-- Основная колонка: панели фиксированы, WebView занимает остаток (без наложений) -->
    <LinearLayout
        android:id="@+id/main_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель (iOS navigation bar) -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@color/ios_bar">

            <ImageButton
                android:id="@+id/btn_nav_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ios_back"
                android:tint="@color/ios_blue"
                android:scaleType="centerInside"
                android:contentDescription="@string/nav_back"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="@color/ios_text"
                    android:textSize="16sp"
                    android:singleLine="true"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textColor="@color/ios_text_secondary"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:gravity="center" />
            </LinearLayout>

            <Space
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Прогресс-бар (как в iOS Safari) -->
        <View
            android:id="@+id/progress_bar"
            android:layout_width="84dp"
            android:layout_height="2.5dp"
            android:layout_gravity="start"
            android:background="@color/ios_blue"
            android:alpha="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Контент -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ios_background" />

            <!-- Оффлайн-экран (прокручивается) -->
            <ScrollView
                android:id="@+id/offline_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ios_background"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="48dp">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp">

                        <View
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_icon_ring" />

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ios_wifi_slash"
                            android:tint="@color/ios_blue"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/offline_title"
                        android:textColor="@color/ios_text"
                        android:textSize="26sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/offline_message"
                        android:textColor="@color/ios_text_secondary"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp" />

                    <TextView
                        android:id="@+id/offline_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/offline_hint"
                        android:textColor="@color/ios_text_tertiary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/retry_button"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/bg_ios_button_primary"
                        android:stateListAnimator="@null"
                        android:text="@string/retry"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />

                    <Button
                        android:id="@+id/open_connection_button"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@android:color/transparent"
                        android:text="@string/connection_methods"
                        android:textAllCaps="false"
                        android:textColor="@color/ios_blue"
                        android:textSize="15sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Нижняя панель (iOS toolbar) -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/ios_bar">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_back"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_back" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_forward"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_forward" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_refresh"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_refresh" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_shield"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_shield"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/sheet_title" />

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="9dp"
                    android:background="@drawable/bg_ios_dot" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_share"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_share" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Полноэкранное видео -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <!-- Шторка «Подключение» (iOS bottom sheet) -->
    <FrameLayout
        android:id="@+id/sheet_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sheet_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:alpha="0"
            android:clickable="true"
            android:focusable="true" />

        <ScrollView
            android:id="@+id/sheet_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_ios_sheet"
            android:elevation="24dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- Заголовок (тянущаяся область) -->
                <LinearLayout
                    android:id="@+id/sheet_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_ios_handle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sheet_title"
                        android:textColor="@color/ios_text"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/sheet_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_idle"
                        android:textColor="@color/ios_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Сегментированный контрол режимов -->
                <ai.arena.webapp.ui.SegmentedControl
                    android:id="@+id/mode_segments"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="18dp" />

                <!-- Карточка: зеркало -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_ios_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_ios_link"
                            android:tint="@color/ios_blue"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/mirror_switch_title"
                                android:textColor="@color/ios_text"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/mirror_switch_desc"
                                android:textColor="@color/ios_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ai.arena.webapp.ui.SwitchView
                            android:id="@+id/mirror_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/ios_separator" />

                    <LinearLayout
                        android:id="@+id/mirror_config"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/mirror_url_input"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_ios_field"
                            android:hint="@string/mirror_url_hint"
                            android:textColorHint="@color/ios_text_tertiary"
                            android:textColor="@color/ios_text"
                            android:textSize="14sp"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:importantForAutofill="no" />

                        <Button
                            android:id="@+id/btn_save_mirror"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_ios_button_primary"
                            android:stateListAnimator="@null"
                            android:text="@string/mirror_save"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/mirror_section_hint"
                            android:textColor="@color/ios_text_tertiary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Карточка: пул прокси -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/bg_ios_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_ios_server"
                            android:tint="@color/ios_blue"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/proxy_pool_title"
                                android:textColor="@color/ios_text"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/proxy_status_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/proxy_test"
                                android:textColor="@color/ios_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_test_proxies"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:background="@android:color/transparent"
                            android:text="@string/proxy_test"
                            android:textAllCaps="false"
                            android:textColor="@color/ios_blue"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
