<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background">

    <!-- Основная колонка: панели фиксированы, WebView занимает остаток -->
    <LinearLayout
        android:id="@+id/main_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Верхняя панель (iOS navigation bar) -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@color/ios_bar">

            <ImageButton
                android:id="@+id/btn_nav_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ios_back"
                android:tint="@color/ios_blue"
                android:scaleType="centerInside"
                android:contentDescription="@string/nav_back"
                android:visibility="invisible" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/ios_text"
                android:textSize="16sp"
                android:singleLine="true"
                android:gravity="center" />

            <Space
                android:layout_width="44dp"
                android:layout_height="44dp" />
        </LinearLayout>

        <!-- Прогресс-бар (как в iOS Safari) -->
        <View
            android:id="@+id/progress_bar"
            android:layout_width="84dp"
            android:layout_height="2.5dp"
            android:layout_gravity="start"
            android:background="@color/ios_blue"
            android:alpha="0" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Контент -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ios_background" />

            <!-- Оффлайн-экран (прокручивается) -->
            <ScrollView
                android:id="@+id/offline_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/ios_background"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="48dp">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp">

                        <View
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_icon_ring" />

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ios_wifi_slash"
                            android:tint="@color/ios_blue"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="26dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/offline_title"
                        android:textColor="@color/ios_text"
                        android:textSize="26sp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/offline_message"
                        android:textColor="@color/ios_text_secondary"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp" />

                    <Button
                        android:id="@+id/retry_button"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="30dp"
                        android:background="@drawable/bg_ios_button_primary"
                        android:stateListAnimator="@null"
                        android:text="@string/retry"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/ios_separator" />

        <!-- Нижняя панель (iOS toolbar) -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@color/ios_bar">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_back"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_back" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_forward"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_forward" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_refresh"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_refresh" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_assistant"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ai_sparkle"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/assistant_title" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ios_share"
                    android:tint="@color/ios_blue"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/nav_share" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Полноэкранное видео -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

    <!-- Шторка AI-помощника (iOS bottom sheet) -->
    <FrameLayout
        android:id="@+id/sheet_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sheet_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:alpha="0"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/sheet_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_ios_sheet"
            android:elevation="24dp">

            <!-- Заголовок (тянущаяся область) -->
            <LinearLayout
                android:id="@+id/sheet_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="5dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ios_handle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_ai_sparkle"
                        android:tint="@color/ios_blue"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/assistant_title"
                            android:textColor="@color/ios_text"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/assistant_subtitle"
                            android:textColor="@color/ios_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Быстрые подсказки -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:id="@+id/chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- Чат -->
            <ScrollView
                android:id="@+id/chat_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/chat_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp" />
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/ios_separator" />

            <!-- Ввод -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <EditText
                    android:id="@+id/assistant_input"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ios_field"
                    android:hint="@string/assistant_hint"
                    android:textColorHint="@color/ios_text_tertiary"
                    android:textColor="@color/ios_text"
                    android:textSize="14sp"
                    android:inputType="textCapSentences|textMultiLine"
                    android:imeOptions="actionSend"
                    android:maxLines="3"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:importantForAutofill="no" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_ios_button_primary"
                    android:src="@drawable/ic_send"
                    android:tint="#FFFFFF"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/assistant_send" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
